<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ page import="java.util.List,com.localbiz.model.Business,com.localbiz.dao.BusinessDAO" %>
<% if(session.getAttribute("userId")==null||!"ADMIN".equals(session.getAttribute("role"))){response.sendRedirect("login.jsp?message=Admin+login+required");return;} List<Business> all=new BusinessDAO().findAllForAdmin(); %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Admin Dashboard | LocalBiz Launch</title><link rel="stylesheet" href="style.css"><style>.admin-wrap{max-width:1200px;margin:45px auto;padding:0 24px}.admin-table-wrap{overflow:auto;background:white;border:1px solid var(--line);border-radius:12px}.admin-table{border-collapse:collapse;width:100%;font-size:12px}.admin-table th,.admin-table td{padding:13px;text-align:left;border-bottom:1px solid var(--line)}.admin-table th{background:var(--sage);color:var(--green)}.status{font-weight:800;font-size:10px}.admin-actions{display:flex;gap:7px}.admin-actions button{border:0;border-radius:5px;padding:8px 10px;cursor:pointer;font-weight:700}.approve{background:#dcfce7;color:#166534}.reject{background:#fee2e2;color:#991b1b}.admin-note{background:white;padding:16px;border-radius:9px;margin-bottom:20px}</style></head><body>
<header class="site-header"><a class="brand" href="HomeServlet"><span class="brand-mark">L<span>+</span></span><span>LocalBiz <strong>Launch</strong></span></a><nav class="main-nav"><a href="HomeServlet">Home</a><a href="BusinessServlet">Explore businesses</a></nav><div class="header-actions"><a class="btn btn-quiet" href="LogoutServlet">Log out</a></div></header>
<main class="admin-wrap"><span class="eyebrow">PLATFORM MANAGEMENT</span><h1>Business approvals</h1><p>Review submitted listings and approve businesses to make them visible publicly.</p><%String msg=request.getParameter("message");if(msg!=null){%><div class="admin-note"><%=msg.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;")%></div><%}%>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>ID</th><th>Business</th><th>Category</th><th>Area</th><th>Status</th><th>Actions</th></tr></thead><tbody>
<%if(all.isEmpty()){%><tr><td colspan="6">No business listings have been submitted yet.</td></tr><%}else{for(Business b:all){%><tr><td><%=b.getBusinessId()%></td><td><strong><%=b.getBusinessName()==null?"":b.getBusinessName().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;")%></strong><br><small><%=b.getPhone()==null?"":b.getPhone()%></small></td><td><%=b.getCategoryName()==null?"":b.getCategoryName()%></td><td><%=b.getAreaName()==null?"":b.getAreaName()%></td><td><span class="status"><%=b.getStatus()%></span></td><td><%if(!"APPROVED".equals(b.getStatus())){%><form class="admin-actions" action="AdminApprovalServlet" method="post"><input type="hidden" name="businessId" value="<%=b.getBusinessId()%>"><button class="approve" name="action" value="approve">Approve</button><button class="reject" name="action" value="reject">Reject</button></form><%}else{%>Published<%}%></td></tr><%}}%>
</tbody></table></div></main></body></html>
