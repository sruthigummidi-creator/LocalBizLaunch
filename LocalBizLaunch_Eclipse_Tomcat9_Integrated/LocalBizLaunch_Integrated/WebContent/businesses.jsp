<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ page import="java.util.List,com.localbiz.model.Business" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Explore Businesses | LocalBiz Launch</title><link rel="stylesheet" href="style.css"><style>
.directory{max-width:1200px;margin:45px auto;padding:0 24px}.directory-head{display:flex;justify-content:space-between;align-items:end;gap:20px;flex-wrap:wrap;margin-bottom:25px}.directory-head h1{font-size:clamp(32px,4vw,48px);margin:8px 0}.directory-search{display:flex;gap:10px;max-width:650px;margin:22px 0 30px}.directory-search input{flex:1;min-width:0;padding:13px;border:1px solid var(--line);border-radius:7px;background:white}.directory-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.directory-card{border:1px solid var(--line);border-radius:12px;overflow:hidden;background:white;box-shadow:0 10px 28px #173f350b}.directory-art{height:150px;display:grid;place-items:center;background:linear-gradient(135deg,#e5eee8,#f8f5ec);font-size:50px}.directory-body{padding:20px}.directory-body h2{font-size:20px;margin:10px 0}.directory-body p{font-size:13px;color:var(--muted);overflow-wrap:anywhere}.directory-chip{display:inline-block;padding:5px 9px;border-radius:20px;background:var(--sage);color:var(--green);font-size:10px;font-weight:700}.directory-contact{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.directory-contact a{font-size:11px;font-weight:700;color:var(--green);border:1px solid #cbd8ce;border-radius:6px;padding:8px 10px}.empty-directory{padding:35px;background:white;border:1px solid var(--line);border-radius:12px}@media(max-width:900px){.directory-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.directory-grid{grid-template-columns:1fr}.directory-search{flex-direction:column}}
</style></head><body>
<header class="site-header"><a class="brand" href="HomeServlet"><span class="brand-mark">L<span>+</span></span><span>LocalBiz <strong>Launch</strong></span></a><nav class="main-nav"><a href="HomeServlet">Home</a><a class="active" href="BusinessServlet">Explore businesses</a><a href="#how">How it works</a></nav><div class="header-actions"><a class="btn btn-quiet" href="login.jsp">Log in</a><a class="btn btn-primary btn-small" href="register.jsp">Get started ↗</a></div></header>
<main class="directory"><div class="directory-head"><div><span class="eyebrow">GOOD PEOPLE, GREAT FINDS</span><h1>Explore local businesses</h1><p>Discover approved shops, makers and services in your community.</p></div></div>
<form class="directory-search" action="BusinessServlet" method="get"><input name="q" value="<%=request.getParameter("q")==null?"":request.getParameter("q").replace("&","&amp;").replace("\"","&quot;")%>" placeholder="Search name, category, area, phone or email"><button class="btn btn-primary" type="submit">Search →</button></form>
<div class="directory-grid"><%
List<Business> rows=(List<Business>)request.getAttribute("businesses");
if(rows==null||rows.isEmpty()){%><div class="empty-directory"><h2>No approved businesses found</h2><p>Try another search, or check back after local owners are approved.</p><a class="btn btn-primary" href="register.jsp?role=OWNER">List your business</a></div><%}else{for(Business b:rows){
String nm=b.getBusinessName()==null?"Local business":b.getBusinessName();
String cat=b.getCategoryName()==null?"Local business":b.getCategoryName();
String desc=b.getDescription()==null||b.getDescription().trim().isEmpty()?"No description provided.":b.getDescription();
String area=b.getAreaName()==null?"Area not specified":b.getAreaName();
%><article class="directory-card">
<%if(b.getLogoPath()!=null&&!b.getLogoPath().trim().isEmpty()){%><img class="directory-art" style="width:100%;object-fit:cover" src="<%=request.getContextPath()%>/<%=b.getLogoPath().replace("\"","")%>" alt="Business logo"><%}else{%><div class="directory-art">🏪</div><%}%>
<div class="directory-body"><span class="directory-chip"><%=cat.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;")%></span><h2><%=nm.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;")%></h2><p><%=desc.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;")%></p>
<p><strong>Area:</strong> <%=area.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;")%></p>
<p><strong>Address:</strong> <%=b.getStreetAddress()==null||b.getStreetAddress().isEmpty()?"Not provided":b.getStreetAddress().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;")%></p>
<p><strong>Phone:</strong> <%=b.getPhone()==null||b.getPhone().isEmpty()?"Not provided":b.getPhone().replace("\"","")%></p>
<p><strong>Email:</strong> <%=b.getEmail()==null||b.getEmail().isEmpty()?"Not provided":b.getEmail().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;")%></p>
<span class="directory-chip">APPROVED</span><div class="directory-contact"><%if(b.getPhone()!=null&&!b.getPhone().isEmpty()){%><a href="tel:<%=b.getPhone().replace("\"","")%>">Call business</a><%}if(b.getEmail()!=null&&!b.getEmail().isEmpty()){%><a href="mailto:<%=b.getEmail().replace("\"","")%>">Send email</a><%}%></div></div></article><%}}%></div></main>
<footer class="site-footer"><a class="brand footer-brand" href="HomeServlet"><span class="brand-mark">L<span>+</span></span><span>LocalBiz <strong>Launch</strong></span></a><p>Helping local businesses find their next customer.</p><small>© 2026 LocalBiz Launch</small></footer></body></html>
