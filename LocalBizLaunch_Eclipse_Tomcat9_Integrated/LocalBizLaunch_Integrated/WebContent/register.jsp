<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Create account | LocalBiz Launch</title><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"><link rel="stylesheet" href="style.css"><link rel="stylesheet" href="auth.css"></head>
<body class="auth-body"><header class="auth-header"><a class="brand" href="HomeServlet"><span class="brand-mark">L<span>+</span></span><span>LocalBiz <strong>Launch</strong></span></a><a href="HomeServlet" class="auth-back">← Back to home</a></header><main class="auth-layout register-layout"><section class="auth-story"><span class="eyebrow eyebrow-light">START SOMETHING GOOD</span><h1>Your next step<br>starts <span>here.</span></h1><p>Join a community that makes it easier to discover local talent and help independent businesses grow.</p><div class="auth-story-art">✿<span>✦</span></div><small>One community. More local possibilities.</small></section><section class="auth-panel"><div class="auth-form-wrap"><span class="eyebrow">LET’S GET YOU STARTED</span><h2>Create your account</h2><p class="auth-intro">First, tell us a little about yourself.</p><% String msg=request.getParameter("message"); if(msg!=null){ %><p class="form-message"><%=msg.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;")%></p><% } %><form id="registerForm" action="RegisterServlet" method="post"><label>Full name<input type="text" id="fullName" name="fullName" placeholder="Your full name" required autocomplete="name" minlength="2"></label><label>Email address<input type="email" id="email" name="email" placeholder="you@example.com" required autocomplete="email"></label><label>Phone number <span class="optional">(optional)</span><input type="tel" id="phone" name="phone" placeholder="Your contact number" autocomplete="tel"></label><label>I want to join as<select id="role" name="role" required><option value="">Choose an account type</option><option value="CUSTOMER">Customer — discover local businesses</option><option value="OWNER">Business owner — list my business</option></select></label><label>Password<input type="password" id="password" name="password" placeholder="At least 8 characters" required minlength="8" autocomplete="new-password"></label><label>Confirm password<input type="password" id="confirmPassword" placeholder="Enter your password again" required minlength="8" autocomplete="new-password"></label><button class="btn btn-primary auth-submit" type="submit">Create account <span>→</span></button><p class="form-message" id="formMessage" aria-live="polite"></p></form><p class="auth-switch">Already have an account? <a href="login.jsp">Log in</a></p><p class="demo-note">Your account will be securely saved to LocalBiz Launch.</p></div></section></main><script src="js/app-auth.js"></script></body></html>
